# ==============================================================================
# ACCA Monorepo — Example Root Environment Configuration (Docker & Monorepo)
# Salin berkas ini ke `.env` dan sesuaikan nilainya dengan konfigurasi lokal/server.
# ==============================================================================

# ── 1. Ports & Server URLs ───────────────────────────────────────────────────
PORT=3006
API_PORT=3007
NEXT_PUBLIC_NEST_API_URL=http://localhost:3007/api
NEXT_PUBLIC_BASE_URL=https://accav2.icgowa.sch.id
APP_PUBLIC_URL=https://accav2.icgowa.sch.id
CORS_ORIGIN=http://localhost:3000,http://localhost:3006,http://localhost:3007,https://accav2.icgowa.sch.id,https://acca.icgowa.sch.id

# ── 2. Database (PostgreSQL) ──────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/acca_db?schema=public"

# Dedicated PostgreSQL connection for PTSP data (separate Supabase project).
# Configure this as a server-side secret; never expose it with NEXT_PUBLIC_.
PTSP_DATABASE_URL="postgresql://postgres.suwdqtaxnooowxaxvilr:[GANTI_DENGAN_PASSWORD_DATABASE_URL_ENCODED]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Prisma schema operations use Supabase's session-mode pooler (port 5432).
PTSP_DIRECT_URL="postgresql://postgres.suwdqtaxnooowxaxvilr:[GANTI_DENGAN_PASSWORD_DATABASE_URL_ENCODED]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── 3. Authentication & Security (Harus sama persis antara Web & API) ─────────
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=your_internal_api_key_for_trusted_service_calls

# ── 4. Cloudflare R2 Object Storage ───────────────────────────────────────────
STORAGE_DRIVER=cloudflare
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=acca
R2_PUBLIC_BASE_URL=https://your-r2-worker-or-custom-domain.workers.dev

# ── 5. Single Sign-On (SSO) Secrets & Integrations ────────────────────────────
CBT_SSO_SECRET=your_cbt_sso_secret_key
TOOLS_SSO_SECRET=your_tools_sso_secret_key
NEXT_PUBLIC_CBT_URL=http://localhost:3008
NEXT_PUBLIC_TOOLS_URL=https://acca-tools.icgowa.sch.id

# ── 6. Email Service (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="ACCA MAN Insan Cendekia Gowa <acca@icgowa.sch.id>"

# ── 7. Legacy Assets Fallback ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
