# ==============================================================================
# Docker Ignore Configuration for ACCA Monorepo
# ==============================================================================

# Git & Editor
.git
.github
.gitignore
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js Build Outputs & Cache
apps/web/.next/
apps/web/out/
apps/web/.open-next/
apps/web/.wrangler/

# NestJS Build Outputs
apps/api/dist/

# Test & Coverage
coverage/
*.lcov
.nyc_output

# Local environment files (kredensial nyata di-inject via docker compose/secrets)
.env*
!.env.example

# Temporary files & Documentation
*.md
!packages/shared/package.json
scratch/
backups/
legacy/
artifacts/
*.bak
*.dump
*.sql
