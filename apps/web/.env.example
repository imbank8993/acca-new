# ==============================================================================
# ACCA Web (Next.js) — Example Environment Configuration
# Salin berkas ini ke `.env.local` dan sesuaikan nilainya dengan konfigurasi lokal/server.
# ==============================================================================

# ── 1. Server & API Connections ───────────────────────────────────────────────
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001/api
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── 2. Database (PostgreSQL VPS — Direct Prisma access) ────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/acca_db?schema=public"

# ── 3. Authentication & Internal Security ─────────────────────────────────────
# PENTING: JWT_SECRET dan INTERNAL_API_KEY harus SAMA PERSIS antara apps/web dan apps/api
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
INTERNAL_API_KEY=your_internal_api_key_for_trusted_service_calls

# ── 4. Cloudflare R2 Object Storage ───────────────────────────────────────────
STORAGE_DRIVER=cloudflare
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=acca
R2_PUBLIC_BASE_URL=https://your-r2-worker-or-custom-domain.workers.dev

# ── 5. Single Sign-On (SSO) Secrets & Integrations ────────────────────────────
CBT_SSO_SECRET=your_cbt_sso_secret_key
TOOLS_SSO_SECRET=your_tools_sso_secret_key
NEXT_PUBLIC_TOOLS_URL=https://acca-tools.icgowa.sch.id

# ── 6. Legacy Assets Fallback ─────────────────────────────────────────────────
# Digunakan untuk resolusi URL berkas lampiran lama yang tersimpan di Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
