model wali_kelas {
  id           BigInt    @id @default(autoincrement())
  nama_kelas   String
  nip          String
  nama_guru    String
  tahun_ajaran String?
  aktif        Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  semester     String?   @default("Ganjil")

  @@unique([nama_kelas, tahun_ajaran, semester], map: "wali_kelas_kelas_tahun_semester_key")
  @@index([semester], map: "idx_wali_kelas_semester")
  @@index([tahun_ajaran], map: "idx_wali_kelas_tahun")
  @@schema("public")
}

